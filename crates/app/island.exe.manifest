<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifest embutido no island.exe (build.rs).
  - <msix>: liga o executável ao sparse package (Publisher sem o OID de "não assinado": o
    validador side-by-side recusa-o e o .exe nem arranca) (packaging/sparse/AppxManifest.xml), para ter
    identidade quando o pacote está instalado. Sem pacote é ignorado e a app corre igual.
  - DPI: per-monitor v2 desde o arranque (o código também o pede; repetir não faz mal).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.1.0.0" name="DynamicIsland" />
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=DynamicIsland"
        packageName="DynamicIsland"
        applicationId="Island" />
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
